# ===================================
# CRM Produto Digital - Configuracao
# ===================================

# --- Database ---
# DigitalOcean Managed PostgreSQL:
DATABASE_URL=postgresql+asyncpg://usuario:senha@host:25060/defaultdb?ssl=require
# Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=SUA_API_KEY_AQUI
EVOLUTION_INSTANCE_NAME=meu-crm

# --- Kiwify ---
KIWIFY_WEBHOOK_SECRET=seu_secret_opcional
KIWIFY_CHECKOUT_URL=https://pay.kiwify.com.br/SEU_CHECKOUT

# --- OpenAI (para AI Agent - opcional) ---
OPENAI_API_KEY=sk-...

# --- App ---
APP_NAME=MeuCRM
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=true

# --- WhatsApp Group ---
# JID do grupo principal (vendas, suporte, etc.)
WA_GROUP_JID=SEU_GRUPO@g.us

# === AIOX Variables (added 2026-09-16) ===
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Get your key at: https://exa.ai/
EXA_API_KEY=
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=
# Sentry (error tracking)
SENTRY_DSN=
# Railway (deployment)
RAILWAY_TOKEN=
# Vercel (deployment)
VERCEL_TOKEN=
# --------------------------------------------
NODE_ENV=development
AIOX_VERSION=2.2.0

# AIOX_NOTE: The following variables already exist with different values:
# AIOX_SUGGESTED: OPENAI_API_KEY=
